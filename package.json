{
  "name": "semla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H \"${SEMLA_BIND_HOST:-127.0.0.1}\"",
    "build": "next build",
    "start": "next start -H \"${SEMLA_BIND_HOST:-127.0.0.1}\"",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "npx tsc",
    "generate:db-types": "npx supabase gen types typescript --project-id \"$PROJECT_REF\" --schema public > src/types/database.types.ts.tmp && mv src/types/database.types.ts.tmp src/types/database.types.ts || (rm -f src/types/database.types.ts.tmp; echo \"db types unchanged: generation failed\" >&2)",
    "postinstall": "npm install --prefix .pi/packages/semla-otel && npm install --prefix .pi/npm && npm run generate:db-types"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-sigma/core": "^5.0.6",
    "@rive-app/react-webgl2": "^4.31.0",
    "@shadcn/react": "^0.3.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.3",
    "ai": "^7.0.66",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "embla-carousel-react": "^8.6.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "lucide-react": "^1.31.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-otel-trace-waterfall": "https://registry.npmjs.org/react-otel-trace-waterfall/-/react-otel-trace-waterfall-0.9.4.tgz",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "sigma": "^3.0.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.3.7",
    "use-stick-to-bottom": "^1.1.6"
  },
  "overrides": {
    "linkify-it": ">=5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
