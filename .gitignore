# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev session artifacts
/.semla-debug/
/.semla-sessions/
/.semla-state/
/.llm-wiki/

# pi-llm-wiki personal vault (codebase knowledge generated by orient/wiki-ingest)
/.semla-wiki/

# Agent worktrees live inside the repo. Left untracked they show up as
# workspace changes, so any checkout of a different tree state (e.g. entering
# GitButler conflict resolution) deletes them along with the uncommitted work
# of whoever is using them.
/.claude/worktrees/

# Audit and review reports dropped by agent runs. Scratch artifacts rather than
# documentation, and they quote whatever they find — the reports these patterns
# were written for had the Supabase service-role key in plaintext, so keeping
# them out of history is the point. Scoped to the repo root and .pi/ so
# deliberate write-ups under docs/ are unaffected.
/*audit*.md
/*-report.md
/.pi/*.md
