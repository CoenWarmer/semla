#!/bin/sh
#
# The `typescript-language-server` supi asks for, served by TypeScript 7.
#
# supi finds language servers the way every LSP client does: by binary name on
# PATH, spawning `typescript-language-server --stdio`. TypeScript 7 has no
# tsserver and no separate language-server package — it serves LSP from the
# compiler binary itself, as `tsc --lsp -stdio`. This translates between the
# two names, so supi's default configuration keeps working.
#
# A shim rather than supi configuration because supi reads its server config
# from `<cwd>/.pi/supi/config.json` or `~/.pi/agent/supi/config.json`. Semla
# runs the agent in whichever project a session is attached to, so a project
# file here would only apply to sessions working on Semla itself, and the
# global path lives outside the repository that is supposed to determine what
# the agent can see. PATH is the one lever that is per-process and ours.
#
# Note the single dash in `-stdio`: `--stdio` is accepted but makes the server
# exit without answering initialize. supi passes `--stdio`, which is why the
# arguments are replaced here rather than forwarded.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
tsc="$root/node_modules/.bin/tsc"

if [ ! -x "$tsc" ]; then
  echo "typescript-language-server shim: no tsc at $tsc — run npm install" >&2
  exit 127
fi

exec "$tsc" --lsp -stdio
