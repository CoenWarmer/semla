+/** Derive a short repo name from an absolute file path by walking up to the .git root. */
+function repoFromFilePath(filePath: string): string | undefined {
+  if (!filePath) return undefined;
+  let dir = dirname(filePath);
+  while (dir !== dirname(dir)) {
+    if (existsSync(join(dir, ".git"))) return basename(dir);
+    dir = dirname(dir);
+  }
+  return undefined;
+}
